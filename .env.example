# Render.IA servicio de IA - variables de entorno.
# Copia este archivo a .env SOLO en tu máquina; .env está en .gitignore y nunca se sube.
# En Render se configuran en Environment. Los valores de ejemplo son falsos.

PORT=8000

# Clave compartida con el backend (la misma AI_API_KEY de renderia-backend).
# Obligatoria en producción. Genera una con: openssl rand -hex 32
AI_API_KEY=

# Desde dónde se pueden descargar imágenes de planos (separadas por coma).
# IMAGE_URL_PREFIXES=https://renderia-backend.onrender.com/

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
