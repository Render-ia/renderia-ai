# Render.IA servicio de IA - variables de entorno.
# Copia este archivo a .env SOLO en tu máquina; .env está en .gitignore y nunca se sube.
# En Render se configuran en Environment. Los valores de ejemplo son falsos.

PORT=8000

# Clave compartida con el backend (la misma AI_API_KEY de renderia-backend).
# Obligatoria en producción. Genera una con: openssl rand -hex 32
AI_API_KEY=

# Desde dónde se pueden descargar imágenes de planos (separadas por coma).
# IMAGE_URL_PREFIXES=https://renderia-backend.onrender.com/

# --- Gemini (https://aistudio.google.com/apikey) ---
# Sin clave, Gemini queda apagado y el detector geométrico trabaja solo.
GEMINI_API_KEY=
# Modelo rápido (planos y copiloto). Verificado en ai.google.dev el 2026-11-20.
GEMINI_MODEL=gemini-3.8-flash
# Lighter model tried when the main one answers 503/429 (empty = no backup model).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Modelo avanzado para preguntas profundas. Vacío = usa GEMINI_MODEL.
# Hoy no hay un Pro estable; gemini-3.1-pro-preview no tiene capa gratuita.
GEMINI_MODEL_PRO=
# Renders con IA. Vacío = apagado. Todos los modelos de imagen son de pago (~USD 0,07 por imagen).
GEMINI_IMAGE_MODEL=
# Tope diario de llamadas de todo el servicio.
GEMINI_DAILY_LIMIT=300
GEMINI_IMAGE_DAILY_LIMIT=20
